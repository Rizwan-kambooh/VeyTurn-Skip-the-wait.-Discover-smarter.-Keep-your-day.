DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,10.0.2.2
# Production providers such as Neon can supply one pooled PostgreSQL URL:
# DATABASE_URL=postgresql://user:password@host/database?sslmode=require
# Uncomment while PostgreSQL is not installed:
# DB_ENGINE=sqlite
POSTGRES_DB=veyturn
POSTGRES_USER=veyturn
POSTGRES_PASSWORD=choose-a-local-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
CORS_ALLOWED_ORIGINS=http://localhost:8081
APP_TIME_ZONE=Asia/Karachi
GEOCODING_BASE_URL=https://photon.komoot.io
GEOCODING_USER_AGENT=Veyturn/1.0 (contact: your-email@example.com)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=Veyturn <noreply@veyturn.local>

# Required in production to persist uploaded business pictures:
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name

# To send real emails with Gmail, change EMAIL_BACKEND to the SMTP backend,
# enter your Gmail address, and use a Google App Password (not your normal password).
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-address@gmail.com
# EMAIL_HOST_PASSWORD=your-16-character-app-password
# DEFAULT_FROM_EMAIL=Veyturn <your-address@gmail.com>

